APP_NAME=Pointage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Temps réel des comptes partagés — « pusher » vise le Soketi de la pile ;
# « log » coupe le temps réel sans rien casser.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=pointage
PUSHER_APP_KEY=pointage-local
PUSHER_APP_SECRET=secret-local
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
# Ce que voit le navigateur en local (vide en production : même domaine, wss).
PUSHER_CLIENT_HOST=localhost
PUSHER_CLIENT_PORT=6001
PUSHER_CLIENT_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_PORT=8080
VITE_PORT=5174
FORWARD_DB_PORT=33061

# Inscriptions ouvertes ; à passer à false une fois votre profil créé.
POINTAGE_REGISTRATION_OPEN=true

# E-mail qui reçoit les signalements de bug ; vide, ils ne sont que conservés en base.
POINTAGE_MAINTAINER_EMAIL=

# Clés Web Push (rappels de pointage) — générez-les avec : php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="${APP_URL}"
