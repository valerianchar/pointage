# Modèle de configuration pour une mise en ligne.
# Copiez-le en .env sur le serveur, puis remplissez chaque valeur marquée À REMPLIR.

APP_NAME=Pointage
APP_ENV=production
# À REMPLIR : php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# À REMPLIR : l'adresse publique, en https, sans barre oblique finale.
APP_URL=https://pointage.exemple.duckdns.org

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Domaine de l'application. Avec compose.prod.yaml, Caddy obtient le certificat
# pour lui ; avec compose.deploy.yaml, c'est le Traefik du serveur qui s'en charge.
APP_DOMAIN=pointage.exemple.duckdns.org
# À REMPLIR : adresse prévenue par Let's Encrypt avant expiration.
TLS_EMAIL=vous@exemple.fr

# Derrière le Traefik du serveur (compose.deploy.yaml), l'application doit faire
# confiance aux en-têtes X-Forwarded-* venus du réseau « proxy », dont le
# sous-réseau est fixé à la création : 172.30.0.0/24. Avec compose.prod.yaml,
# l'application termine le TLS elle-même : laissez alors la variable vide —
# faire confiance à d'autres adresses permettrait de falsifier l'IP des clients.
TRUSTED_PROXIES=172.30.0.0/24

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pointage
DB_USERNAME=pointage
# À REMPLIR : openssl rand -base64 24
DB_PASSWORD=
# À REMPLIR : openssl rand -base64 24
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Le cookie de session ne doit jamais circuler en clair.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Laissez ouvert le temps de créer votre profil, puis passez à false et
# relancez la pile : l'écran d'inscription devient inaccessible.
POINTAGE_REGISTRATION_OPEN=true

# Envoi d'e-mails — nécessaire pour recevoir les signalements de bug.
# Sans ces lignes, le mailer par défaut est « log » : les messages finissent
# dans les journaux du conteneur et ne partent jamais.
#
# Par défaut, les messages vont dans le Mailpit de la pile : ils se lisent dans
# son interface web, via un tunnel SSH (voir DEPLOIEMENT.md). Rien ne part sur
# Internet. Pour recevoir les e-mails dans une vraie boîte, remplacez par un
# SMTP externe — par exemple Brevo (gratuit, 300 e-mails/jour) : MAIL_HOST
# smtp-relay.brevo.com, MAIL_PORT 587, et les identifiants SMTP du compte.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=pointage@localhost
MAIL_FROM_NAME="${APP_NAME}"

# Interface web de Mailpit sur un sous-domaine, via Traefik. Créez d'abord
# l'enregistrement DNS A du sous-domaine vers l'IP du serveur. L'accès est
# protégé par mot de passe ; générez le haché avec :
#   docker run --rm httpd:2 htpasswd -nbB admin 'VOTRE_MOT_DE_PASSE'
# ATTENTION : doublez chaque « $ » du haché avant de le coller ici ($ → $$),
# sinon Docker Compose les interprète comme des variables et l'accès est
# refusé même avec le bon mot de passe.
# Laissés vides, seul le tunnel SSH donne accès à l'interface.
MAILPIT_DOMAIN=
MAILPIT_BASIC_AUTH=

# E-mail qui reçoit les signalements de bug ; vide, ils ne sont que conservés en base.
POINTAGE_MAINTAINER_EMAIL=

# Clés Web Push (rappels de pointage) — générez-les avec : php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="${APP_URL}"

# Temps réel des comptes partagés, via le Soketi de la pile (compose.deploy.yaml).
# Générez l'identifiant et les clés — trois chaînes aléatoires :
#   openssl rand -hex 16
# Le navigateur se connecte en wss sur le domaine de l'application (/app/…),
# aucune variable client à renseigner ici.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
