# Modèle de configuration pour une mise en ligne.
# Copiez-le en .env sur le serveur, puis remplissez chaque valeur marquée À REMPLIR.

APP_NAME=Pointage
APP_ENV=production
# À REMPLIR : php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# À REMPLIR : l'adresse publique, en https, sans barre oblique finale.
APP_URL=https://pointage.exemple.duckdns.org

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Domaine servi par Caddy, qui obtient le certificat pour lui.
APP_DOMAIN=pointage.exemple.duckdns.org
# À REMPLIR : adresse prévenue par Let's Encrypt avant expiration.
TLS_EMAIL=vous@exemple.fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pointage
DB_USERNAME=pointage
# À REMPLIR : openssl rand -base64 24
DB_PASSWORD=
# À REMPLIR : openssl rand -base64 24
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Le cookie de session ne doit jamais circuler en clair.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Laissez ouvert le temps de créer votre profil, puis passez à false et
# relancez la pile : l'écran d'inscription devient inaccessible.
POINTAGE_REGISTRATION_OPEN=true
